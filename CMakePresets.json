{
  "version": 3,
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native decoder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "AV2HEIF_BUILD_HOST_TESTS": "OFF",
        "AV2HEIF_BUILD_WINDOWS_TOOLS": "OFF",
        "AV2HEIF_BUILD_NATIVE_CLI": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Host C tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "AV2HEIF_BUILD_HOST_TESTS": "ON",
        "AV2HEIF_ENABLE_SANITIZERS": "OFF",
        "AV2HEIF_BUILD_WINDOWS_TOOLS": "OFF"
      }
    },
    {
      "name": "host-sanitized",
      "displayName": "Host C tests (ASan and UBSan)",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-sanitized",
      "cacheVariables": {
        "AV2HEIF_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "linux-nolibc",
      "displayName": "Linux native static no-libc decoder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-nolibc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "AV2HEIF_BUILD_HOST_TESTS": "OFF",
        "AV2HEIF_BUILD_WINDOWS_TOOLS": "OFF",
        "AV2HEIF_BUILD_NATIVE_CLI": "OFF",
        "AV2HEIF_BUILD_LINUX_NOLIBC": "ON"
      }
    },
    {
      "name": "linux-nolibc-x86_64",
      "displayName": "Linux x86-64 static no-libc decoder",
      "inherits": "linux-nolibc",
      "binaryDir": "${sourceDir}/build/linux-nolibc-x86_64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER_TARGET": "x86_64-linux-gnu",
        "CMAKE_ASM_COMPILER_TARGET": "x86_64-linux-gnu",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
      }
    },
    {
      "name": "linux-nolibc-aarch64",
      "displayName": "Linux AArch64 static no-libc decoder",
      "inherits": "linux-nolibc",
      "binaryDir": "${sourceDir}/build/linux-nolibc-aarch64",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER_TARGET": "aarch64-linux-gnu",
        "CMAKE_ASM_COMPILER_TARGET": "aarch64-linux-gnu",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY"
      }
    },
    {
      "name": "macos-nolibc-arm64",
      "displayName": "macOS ARM64 no-import decoder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-nolibc-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_C_FLAGS": "-flto=full",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "AV2HEIF_BUILD_HOST_TESTS": "OFF",
        "AV2HEIF_BUILD_WINDOWS_TOOLS": "OFF",
        "AV2HEIF_BUILD_NATIVE_CLI": "OFF",
        "AV2HEIF_BUILD_MACOS_NOLIBC": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-x86_64",
      "displayName": "Windows x86-64 (freestanding LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER_TARGET": "x86_64-w64-windows-gnu",
        "CMAKE_EXE_LINKER_FLAGS": "--target=x86_64-w64-windows-gnu",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "AV2HEIF_ENABLE_PYTHON_TESTS": "ON",
        "AV2HEIF_BUILD_NATIVE_CLI": "OFF"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 (freestanding LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER_TARGET": "aarch64-w64-windows-gnu",
        "CMAKE_EXE_LINKER_FLAGS": "--target=aarch64-w64-windows-gnu",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "AV2HEIF_ENABLE_PYTHON_TESTS": "ON",
        "AV2HEIF_BUILD_NATIVE_CLI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized"
    },
    {
      "name": "linux-nolibc",
      "configurePreset": "linux-nolibc"
    },
    {
      "name": "linux-nolibc-x86_64",
      "configurePreset": "linux-nolibc-x86_64"
    },
    {
      "name": "linux-nolibc-aarch64",
      "configurePreset": "linux-nolibc-aarch64"
    },
    {
      "name": "macos-nolibc-arm64",
      "configurePreset": "macos-nolibc-arm64"
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64"
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-nolibc",
      "configurePreset": "linux-nolibc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-nolibc-x86_64",
      "configurePreset": "linux-nolibc-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-nolibc-aarch64",
      "configurePreset": "linux-nolibc-aarch64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-nolibc-arm64",
      "configurePreset": "macos-nolibc-arm64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x86_64",
      "configurePreset": "windows-x86_64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}